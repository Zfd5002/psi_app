# Never include envs
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# Never include git metadata
.git/
**/.git/

# Never include local DBs
psi/psi.sqlite
**/*.sqlite
**/*.sqlite3
**/*.db

# Vendored third-party deps (intentionally excluded from overlay ZIPs)
vendor/
**/vendor/
vendor/**
**/vendor/**

# Never include uploads / user files (optional, but usually huge)
uploads/
**/uploads/

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# OS/editor junk
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/

# Editor/backup artifacts
*~
**/*~
*.bak
**/*.bak
*.bak~
**/*.bak~
*.swp
**/*.swp

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log
